{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/projects/layout,_N_T_/projects/[category]/layout,_N_T_/projects/[category]/page,_N_T_/projects/urban"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/projects/$d$category/__PAGE__",
    "/projects/$d$category",
    "/projects",
    "/_index",
    "/_head"
  ]
}